<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#F58529" android:centerColor="#DD2A7B" android:endColor="#8134AF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <stroke android:width="5dp" android:color="#FFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:left="39dp" android:top="39dp" android:right="39dp" android:bottom="39dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:left="68dp" android:top="26dp" android:right="26dp" android:bottom="68dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:left="42dp" android:top="42dp" android:right="42dp" android:bottom="42dp">
        <shape android:shape="oval">
            <solid android:color="#B3000000"/>
            <stroke android:width="2dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:left="52dp" android:top="52dp" android:right="52dp" android:bottom="52dp">
        <rotate android:fromDegrees="-45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF"/>
                <corners android:radius="2dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>