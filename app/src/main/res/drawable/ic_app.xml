<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#F58529" android:centerColor="#DD2A7B" android:endColor="#8134AF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <stroke android:width="5dp" android:color="#FFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:left="43dp" android:top="43dp" android:right="43dp" android:bottom="43dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:left="68dp" android:top="28dp" android:right="28dp" android:bottom="68dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:left="48dp" android:top="48dp" android:right="48dp" android:bottom="48dp">
        <rotate android:fromDegrees="-45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#111111"/>
                <corners android:radius="2dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>