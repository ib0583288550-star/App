<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
 <LinearLayout android:id="@+id/home" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
  <TextView android:text="מבט" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="המדיה שלך. פיד אחד פשוט." android:textColor="#A8A8B8" android:textSize="16sp" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/add" android:text="＋  הוסף תיקייה" android:textColor="#FFFFFF" android:textSize="16sp" android:textAllCaps="false" android:background="@drawable/home_button" android:layout_width="match_parent" android:layout_height="56dp"/>
  <Button android:id="@+id/settings" android:text="⚙  הגדרות" android:textColor="#FFFFFF" android:textSize="16sp" android:textAllCaps="false" android:background="@drawable/home_button" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="50dp"/>\n  <Button android:id="@+id/start" android:text="▶  פתח את הפיד" android:textColor="#FFFFFF" android:textSize="16sp" android:textAllCaps="false" android:background="@drawable/home_button" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="56dp"/>
  <TextView android:id="@+id/status" android:text="בחר תיקייה אחת או יותר" android:textColor="#858596" android:textSize="15sp" android:paddingTop="20dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="מבט • v06 • YB Apps" android:textColor="#777784" android:textSize="12sp" android:gravity="center" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/viewer" android:visibility="gone" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/picture" android:scaleType="fitXY" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <TextureView android:id="@+id/movie" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <TextView android:id="@+id/count" android:textColor="#FFFFFF" android:textSize="14sp" android:background="#66000000" android:padding="8dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/back" android:text="" android:textColor="#FFFFFF" android:textSize="1sp" android:gravity="center" android:background="@drawable/action_back" android:layout_gravity="top|start" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:layout_width="52dp" android:layout_height="52dp"/>
  <LinearLayout android:orientation="vertical" android:layout_gravity="bottom" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <SeekBar android:id="@id/seekBar" android:max="1000" android:progress="0" android:layout_width="match_parent" android:layout_height="30dp" android:paddingStart="0dp" android:paddingEnd="0dp"/>
   <TextView android:id="@id/timeText" android:text="00:00 / 00:00" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="end" android:layout_width="match_parent" android:layout_height="18dp"/>
  </LinearLayout>
  <TextView android:id="@+id/speed" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="#99000000" android:layout_gravity="top|center_horizontal" android:layout_marginTop="58dp" android:layout_width="wrap_content" android:layout_height="34dp" android:visibility="gone" android:paddingStart="12dp" android:paddingEnd="12dp"/>
  <LinearLayout android:id="@+id/actionColumn" android:orientation="vertical" android:gravity="center" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:layout_width="64dp" android:layout_height="wrap_content">
   <TextView android:id="@+id/like" android:text="" android:textColor="#FFFFFF" android:textSize="1sp" android:gravity="center" android:background="@drawable/action_like" android:layout_width="50dp" android:layout_height="50dp" android:includeFontPadding="false"/>
   <TextView android:text="לייק" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="20dp"/>
   <TextView android:id="@+id/share" android:text="" android:textColor="#FFFFFF" android:textSize="1sp" android:gravity="center" android:background="@drawable/action_share" android:layout_marginTop="10dp" android:layout_width="50dp" android:layout_height="50dp" android:includeFontPadding="false"/>
   <TextView android:text="שיתוף" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="20dp"/>
   <TextView android:id="@+id/save" android:text="" android:textColor="#FFFFFF" android:textSize="1sp" android:gravity="center" android:background="@drawable/action_save" android:layout_marginTop="10dp" android:layout_width="50dp" android:layout_height="50dp" android:includeFontPadding="false"/>
   <TextView android:text="שמירה" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="20dp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/bottomInfo" android:orientation="vertical" android:layout_gravity="bottom|start" android:paddingStart="18dp" android:paddingEnd="90dp" android:paddingBottom="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="מבט • תוכן מקומי" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:text="החלק למעלה לפריט הבא • למטה לפריט הקודם" android:textColor="#D8D8E0" android:textSize="13sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
 </FrameLayout>
</FrameLayout>