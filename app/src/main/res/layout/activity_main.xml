<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0A0A0F">
 <LinearLayout android:id="@+id/home" android:orientation="vertical" android:padding="22dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
  <TextView android:text="מבט" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="המדיה שלך. פשוט לגלול וליהנות." android:textColor="#A8A8B8" android:textSize="16sp" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/add" android:text="＋ הוסף תיקייה" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="54dp"/>
  <Button android:id="@+id/start" android:text="▶ התחל לצפות" android:textSize="16sp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="54dp"/>
  <TextView android:id="@+id/status" android:text="בחר תיקייה אחת או יותר" android:textColor="#858596" android:textSize="15sp" android:paddingTop="20dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/viewer" android:visibility="gone" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/picture" android:scaleType="centerCrop" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <VideoView android:id="@+id/movie" android:visibility="gone" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <View android:background="@drawable/bottom_fade" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="250dp"/>
  <View android:background="@drawable/top_fade" android:layout_gravity="top" android:layout_width="match_parent" android:layout_height="120dp"/>
  <TextView android:id="@+id/count" android:textColor="#FFFFFF" android:textSize="14sp" android:background="#66000000" android:padding="8dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/back" android:text="‹" android:textSize="28sp" android:textColor="#FFFFFF" android:background="#55000000" android:layout_gravity="top|start" android:layout_margin="12dp" android:layout_width="52dp" android:layout_height="52dp"/>
  <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:layout_width="70dp" android:layout_height="wrap_content">
   <TextView android:id="@+id/like" android:text="♡" android:textColor="#FFFFFF" android:textSize="42sp" android:gravity="center" android:background="#66000000" android:layout_width="64dp" android:layout_height="64dp"/>
   <TextView android:text="לייק" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="22dp"/>
   <TextView android:id="@+id/share" android:text="↗" android:textColor="#FFFFFF" android:textSize="36sp" android:gravity="center" android:background="#66000000" android:layout_marginTop="12dp" android:layout_width="64dp" android:layout_height="64dp"/>
   <TextView android:text="שיתוף" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="22dp"/>
   <TextView android:id="@+id/save" android:text="⇩" android:textColor="#FFFFFF" android:textSize="36sp" android:gravity="center" android:background="#66000000" android:layout_marginTop="12dp" android:layout_width="64dp" android:layout_height="64dp"/>
   <TextView android:text="שמירה" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:layout_width="64dp" android:layout_height="22dp"/>
  </LinearLayout>
  <LinearLayout android:orientation="vertical" android:layout_gravity="bottom|start" android:paddingStart="18dp" android:paddingEnd="90dp" android:paddingBottom="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="מבט • תוכן מקומי" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:text="החלק למעלה לפריט הבא • למטה לפריט הקודם" android:textColor="#D8D8E0" android:textSize="13sp" android:paddingTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
 </FrameLayout>
</FrameLayout>